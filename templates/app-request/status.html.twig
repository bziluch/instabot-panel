{% extends 'dashboard.html.twig' %}

{% block title %}Status konta IG{% endblock %}
{% block pageTitle %}Status logowania konta IG{% endblock %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block content %}
    <div class="container" data-controller="app-request-status"
         data-app-request-status-id-value="{{ appRequest.id }}"
         data-app-request-status-url-value="{{ path('app_request_status', {id: appRequest.id}) }}"
    >
        <div class="alert alert-secondary mt-3" id="status-box">
            Oczekiwanie na odpowiedź z aplikacji...
        </div>
    </div>
    <div id="twofa-form" class="d-none">
        {{ form(form) }}
    </div>
{% endblock %}