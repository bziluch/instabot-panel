{% extends 'dashboard.html.twig' %}

{% block title %}Lista kont{% endblock %}
{% block pageTitle %}Lista kont{% endblock %}

{% block buttons %}
    <a href="{{ path('app_igaccount_add') }}" class="btn btn-sm btn-warning">Dodaj konto</a>
{% endblock buttons %}

{% block content %}
    <table class="table">
        <thead>
        <tr>
            <th scope="col">l.p.</th>
            <th scope="col">Nazwa konta</th>
            {% if is_granted('ROLE_ADMIN') %}
                <th scope="col">Użytkownik</th>
            {% endif %}
            <th scope="col">Śledzone konto</th>
            <th scope="col">Aktywne</th>
            <th scope="col">Status połączenia</th>
            <th scope="col">Akcje</th>
        </tr>
        </thead>
        <tbody>
        {% if accounts|length > 0 %}
            {% for account in accounts %}
                <tr>
                    <th scope="row">{{ loop.index }}</th>
                    <td>{{ account.username }}</td>
                    {% if is_granted('ROLE_ADMIN') %}
                        <td>{{ account.user.email }}</td>
                    {% endif %}
                    <td>{{ account.linkedAccount }}</td>
                    <td>{{ account.active ? "<span class='badge bg-info text-dark'>TAK</span>" : "<span class='badge bg-secondary'>NIE</span>" }}</td>
                    <td>
                        {% if account.status == 1 %}
                            <span class="badge bg-success">Połączono</span>
                        {% elseif account.status == 2 %}
                            <span class="badge bg-danger">Niepowodzenie</span>
                        {% elseif account.status == 3 %}
                            <span class="badge bg-warning text-dark">Połączenie przerwane</span>
                        {% else %}
                            <span class="badge bg-secondary">Niezweryfikowane</span>
                        {% endif %}

                    </td>
                    <td>
                        {% if app.user == account.user %}
                            {% if account.lastAppRequest and account.lastAppRequest.status != 2 %}
                                <a class="btn btn-sm btn-warning" href="{{ path('app_request_view', {id: account.lastAppRequest.id}) }}">Sprawdź połączenie</a>
                            {% else %}
                                <a class="btn btn-sm btn-secondary" href="{{ path('app_igaccount_edit', {id: account.id}) }}">Edytuj dane konta</a>
                            {% endif %}
                        {% endif %}
{#                        {% if account.active %}#}
{#                            <a class="btn btn-sm btn-danger">Ustaw jako nieaktywne</a>#}
{#                        {% else %}#}
{#                            <a class="btn btn-sm btn-success">Ustaw jako aktywne</a>#}
{#                        {% endif %}#}
                    </td>
                </tr>
            {% endfor %}
        {% else %}
            <tr>
                <td colspan="6">
                    Brak danych do wyświetlenia
                </td>
            </tr>
        {% endif %}
        </tbody>
    </table>
{% endblock %}
