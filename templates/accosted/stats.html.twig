{% extends 'dashboard.html.twig' %}

{% block title %}Statystyki zaczepionych kont{% endblock %}
{% block pageTitle %}Statystyki zaczepionych kont{% endblock %}

{% block content %}

    <table class="table table-striped table-bordered text-center align-middle">
        <thead class="table-dark">
        <tr>
            <th>Okres</th>
            <th>Liczba zaczepionych</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td>Dzisiaj ({{ "now"|date("d.m.Y") }})</td>
            <td><strong>{{ todayCount }}</strong></td>
        </tr>
        <tr>
            <td>Ten miesiąc ({{ "now"|date("m.Y") }})</td>
            <td><strong>{{ thisMonthCount }}</strong></td>
        </tr>
        <tr>
            <td>Poprzedni miesiąc</td>
            <td><strong>{{ previousMonthCount }}</strong></td>
        </tr>
        <tr>
            <td>Łącznie</td>
            <td><strong>{{ totalCount }}</strong></td>
        </tr>
        </tbody>
    </table>
{% endblock %}